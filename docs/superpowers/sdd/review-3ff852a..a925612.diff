+  return Math.round(t <= 0 ? 235 + 25 * t : 235 - 195 * t);
+}
+
 /** 色彩微调覆盖：hue -1 = 跟随主题色；saturation 100 = 原饱和度。默认态不写任何覆盖（主题色原样生效）。 */
