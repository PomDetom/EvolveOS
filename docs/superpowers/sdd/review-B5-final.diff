     // 旧容器已退订：仍停留在挂载时的默认值 0.6（不再被同步）
-    expect(old.querySelector('.ml-slider').value).toBe('0.6');
+    expect(old.querySelector('.c-slider').value).toBe('0.6');
   });
 });
