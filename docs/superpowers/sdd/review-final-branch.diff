++  transition: opacity var(--dur-base) var(--ease-out),
++    transform var(--dur-base) var(--ease-out);
++}
++.c-strip[data-orientation="vertical"] .c-strip__content { flex-direction: column; }
++/* 旋转中：内容淡出 + 轻微缩放（只动 transform/opacity），翻转到新形态后淡入 */
