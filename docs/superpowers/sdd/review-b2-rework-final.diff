+
+```js
+test('导航栏顶部无叠加遮罩色带（内容遮罩）', async ({ page }) => {
+  await page.goto('/?mode=app');
+  // 顶部遮罩不再是叠加渐变层（.c-navwheel__mask 元素不存在）
